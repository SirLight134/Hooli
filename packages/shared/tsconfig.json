{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "outDir": "./dist",
        "rootDir": "./src",
        "declaration": true,
        "declarationMap": true,
        "composite": true,
        "lib": [
            "ES2020"
        ],
        "module": "ESNext",
        "target": "ES2020",
        "moduleResolution": "bundler"
    },
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "../../apps",
        "../../packages/*/node_modules"
    ]
}